#!name = 知乎去广告
#!desc = 基于可莉 Zhihu_remove_ads（2026-10-02）：去开屏 / 信息流 / 回答页广告、精简标签与我的页面；另去热榜标签与热榜内容、搜索页“猜你想搜”与“大家都在搜”（整块不渲染，只留搜索框）。
#!author = 可莉🅥（原插件）
#!date = 2026-11-04 10:12:00
# 来源说明：kelee.one 当日被 Cloudflare 拦截无法直读，内容以同源 Surge 模块镜像（Repcz/Tool，2026-10-02）逐条核对后转为 Loon 写法；jq 表达式原文照搬。
# 本版相对原插件的改动（均标“改/新增”）：
#  1. 顶部标签去掉 hot（热榜 tab 不再出现）；
#  2. search/recommend_query 直接拒绝请求（“猜你想搜”整块不渲染；v1 曾只清空数据，结果只剩标题和占位条）；
#  3. 新增 search/hot_search 直接拒绝请求（“大家都在搜”整块不渲染；v1 曾空返回 {}，结果只剩标题和占位条）与 topstory/hot-lists 空返回（热榜内容兜底）。

[Rewrite]
# m-cloud 配置：去掉 HTTPDNS / QUIC 相关配置（原版）
^https://m-cloud\.zhihu\.com/api/cloud/zhihu/config/all\? response-body-json-jq 'def drop_keys: {\"km_httpdns_new_config_tars\":true,\"preFetchHttpDns\":true,\"httpdns_detector_use_concurrent\":true,\"httpdns_use_memory_cache\":true,\"httpdns_new_config_tars\":true,\"coreNetworkConf_useTars\":true,\"km_coreNetworkConf_useTars\":true,\"sugarQuicConfig\":true,\"quic_dns_detect_enable\":true,\"quicMixAB\":true,\"quic_downgrade_enable\":true,\"quic_priority_strategy\":true,\"quic_check_health_enable\":true,\"tquic_configuration\":true,\"networkExprimentList\":true,\"tars_ab_list\":true,\"zaSetExtraRequestHeader\":true}; .data.configs |= map(select((drop_keys[.configKey] // false) | not) | if (.configValue | type) == \"object\" then del(.configValue.delayHttpdns, .configValue.dnsParser, .configValue.HTTPDNS) else . end)'
# 顶部标签：改——去掉 hot，只留 follow / recommend / ring_tab（原版还留 hot）
^https://api\.zhihu\.com/root/tab/v\d(?:\?.+)?$ response-body-json-jq '.tab_list |= map(select(.tab_type == \"follow\" or .tab_type == \"recommend\" or .tab_type == \"ring_tab\"))'
# 推荐信息流：只留 ComponentCard（原版）
^https://api\.zhihu\.com/topstory/recommend\? response-body-json-jq '.data |= map(select(.type == \"ComponentCard\"))'
^https://api\.zhihu\.com/topstory/recommend\? response-body-json-jq '.data[]?.children |= (if type == \"array\" then map(select(.id != \"ring\")) else . end)'
# 新增：热榜内容接口直接空返回（兜底，标签去掉后一般不再请求）
^https://api\.zhihu\.com/topstory/hot-lists reject-dict
^https://api\.zhihu\.com/v2/topstory/hot-lists reject-dict
# 问题 feeds 去广告（原版）
^https://api\.zhihu\.com/questions/\d+/feeds\? response-body-json-jq 'delpaths([[\"ad_info\"]])'
# 评论区氛围投票调查（原版）
^https://api\.zhihu\.com/comment_v\d/(answers|pins)/\d+/root_comment\? response-body-json-jq 'delpaths([[\"atmosphere_voting_config\"]])'
# 回答页：第三方业务、悬浮搜词、卡片段（原版）
^https://(api|page-info)(?:\.zhihu)?\.com/answers/v\d/\d+(?:\?.*)?$ response-body-json-jq 'delpaths([[\"third_business\"]])'
^https://(api|page-info)(?:\.zhihu)?\.com/answers/v\d/\d+(?:\?.*)?$ response-body-json-jq 'delpaths([[\"float_search_word\"]])'
^https://(api|page-info)(?:\.zhihu)?\.com/answers/v\d/\d+(?:\?.*)?$ response-body-json-jq '.structured_content.segments |= map(select(.type != \"card\"))'
# 文章 / 回答 / 动态：第三方业务、ring 信息、互动栏插件（原版）
^https://api\.zhihu\.com/(articles|answers|pins)/v\d/\d+\? response-body-json-jq 'delpaths([[\"third_business\"]])'
^https://api\.zhihu\.com/(articles|answers|pins)/v\d/\d+\? response-body-json-jq 'delpaths([[\"ring_info\"]])'
^https://api\.zhihu\.com/(articles|answers|pins)/v\d/\d+\? response-body-json-jq 'delpaths([[\"interaction_bar_plugins\"]])'
# 回答详情评论区连续消费模块（原版）
^https://api\.zhihu\.com/comment_v\d/answers/\d+/list-headers$ response-body-json-jq 'delpaths([[\"continuous_consumption_module\"]])'
# 播客横幅（原版）
^https://api\.zhihu\.com/podcasts/hub/v\d$ response-body-json-jq 'delpaths([[\"banners\"]])'
# 猜你想搜：改——直接拒绝请求，整块不渲染（原版只留 type=normal 的；只清空数据会留标题和占位条）
^https://api\.zhihu\.com/search/recommend_query/v\d\? reject
# 搜索页挂件（原版）
^https://api\.zhihu\.com/search_v\d\? response-body-json-jq 'delpaths([[\"pendant\"]])'
# 搜索 tabs 白名单（原版）
^https://api\.zhihu\.com/search/tabs\? response-body-json-jq '.data |= map(select(.t | IN(\"general\", \"ai_zhida\", \"recent\", \"people\", \"zvideo\", \"ring\", \"topic\", \"podcast\", \"column\", \"pin\", \"favlist\")))'
# 我的页面精简（原版）
^https://api\.zhihu\.com/people/self$ response-body-json-jq 'delpaths([[\"vip_info\",\"entrance_new\",\"right_button\"]])'
^https://api\.zhihu\.com/people/self$ response-body-json-jq 'delpaths([[\"vip_info\",\"entrance_v2\"]])'
# 新增：大家都在搜——直接拒绝请求，整块不渲染（只空返回 {} 会留标题和占位条）
^https://api\.zhihu\.com/search/hot_search reject
# 以下为空返回类（原版 Map Local 的 {}，Loon 用 reject-dict）
^https://api\.zhihu\.com/ad-style-service/request$ reject-dict
^https://api\.zhihu\.com/commercial_api/ reject-dict
^https://api\.zhihu\.com/commercial_api/banners_v\d/app_float_corner\? reject-dict
^https://api\.zhihu\.com/next-render\?id=\d+&type=answer reject-dict
^https://api\.zhihu\.com/commercial_api/answer/\d+/bottom-v\d$ reject-dict
^https://api\.zhihu\.com/related_recommend/feed/waterfall\? reject-dict
^https://api\.zhihu\.com/search/preset_words\? reject-dict
^https://api\.zhihu\.com/search/related_queries/question/\d+$ reject-dict
^https://zhida\.zhihu\.com/ai_ingress/knowledge/square/categories/feeds\?categoryId=1%7D$ reject-dict
^https://zhida\.zhihu\.com/ai_ingress/ai_chat/guidance$ reject-dict
^https://api\.zhihu\.com/content-distribution-core/bubble/common/show$ reject-dict
^https://www\.zhihu\.com/api/v\d/members/homepage_card$ reject-dict
^https://api\.zhihu\.com/people/homepage_entry_v\d$ reject-dict
^https://api\.zhihu\.com/kvip/right/my_card\? reject-dict
^https://api\.zhihu\.com/unlimited/go/my_card/v\d\? reject-dict

[MITM]
hostname = m-cloud.zhihu.com, api.zhihu.com, www.zhihu.com, page-info.zhihu.com, zhida.zhihu.com

[Script]
# 临时诊断：只记录、不改数据；拿到特征后删除
# 1) 信息流结构诊断：记录 topstory/recommend 每条的 type/字段/广告特征词
http-response ^https:\/\/api\.zhihu\.com\/topstory\/recommend\? script-path = https://raw.githubusercontent.com/LeBron93/lewis/b371967ac54a45a734191c584f10d41183d6b2f8/Scripts/zhihu-feed-diag.js, requires-body = true, tag = 信息流结构诊断
# 2) 配置开关诊断：记录 m-cloud 全部 configKey，找控制搜索页模块的开关
http-response ^https:\/\/m-cloud\.zhihu\.com\/api\/cloud\/zhihu\/config\/all\? script-path = https://raw.githubusercontent.com/LeBron93/lewis/b371967ac54a45a734191c584f10d41183d6b2f8/Scripts/zhihu-feed-diag.js, requires-body = true, tag = 配置开关诊断
