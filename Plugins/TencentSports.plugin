#!name = 腾讯体育去广告
#!desc = 拦截开屏广告，移除首页信息流、会员推广、赛事页横幅、悬浮运营组件、金币任务会员弹层及赛事 PageCard 强制弹窗、精简我的页面与首页展示
# Loon 插件版 v6（2026-11-02，用户要求把 ZenmoFeiShi 的“精简我的页面”并进来）：在 v5 基础上追加 Zenmo 脚本的 7 条规则（getsdkconfig、init/config、homePageV2、liveSum、multiUpdate、feeds/home|list、sports.ssp/app，规则与脚本地址原样抄自 txsports-ad-clean.plugin v5，脚本为 Scripts/txsports-ad-clean-loon.js 的 jsDelivr 固定 commit 2f3746fc）；GetTabRemoteConfig 一条未并入——本插件的 Rewrite reject-200 已拦掉该接口（开屏已确认有效），并入后脚本只能拿到空 body，改写不会生效，故保留 reject-200；feeds/list 与 Hey-sayiwanna 脚本同接口，Zenmo 规则放后面顺序执行（先过滤广告条目，再清 hotWords/adInfos/1120 栏）；MITM 加 k.ssp.qq.com、sports.ssp.qq.com。原独立插件 txsports-ad-clean.plugin 不再需要，可停用删除。
# Loon 插件版 v5（2026-11-02，按 Hey-sayiwanna/TencentSports-Surge 的 TencentSportsAdBlock.sgmodule 原样转换，blob SHA 6fdad93dcc4818bc02b7c126267ed9aaf2f24fec；脚本全文已读：两脚本仅用 $request.url/$response.body/$done/console.log，无 QX 专属 API，Loon 原生兼容，无需垫片，仍引用原作者远程地址）。新增：[Host] 系统 DNS 段、l.qq.com reject-dict、MITM 加 *.l.qq.com；原 [Rule] HTTPDNS+GDT 层保留。
#!author = Hey-sayiwanna
#!homepage = https://github.com/Hey-sayiwanna/TencentSports-Surge
# Loon 重写版：以 Hey-sayiwanna/TencentSports-Surge 为准，从头重写，共三层。
# 第一层（基础层，对齐原作者要求的前置模块）：拦截 HTTPDNS，强制 App 走 Loon 的 DNS，否则域名规则会被 HTTPDNS 直连 IP 绕过。
# 第二层（广告平台层，对齐原作者要求的前置模块）：腾讯优量汇 GDT 域名直连拦截，开屏广告走的就是这一层。
# 第三层（体育 App 自身层，原模块本体）：Rewrite + Script + MITM。两脚本仅用 $request/$response/$done，Loon 原生兼容，无需改写，仍引用原作者远程地址；Surge 的 Map Local（空 body + 200 + application/proto 头）转成 Loon 的 reject-200（空 body + 200，不带自定义头）；MITM 去掉 Surge 专用的 %APPEND%。
# 注意：仓库里「去广告原理代码参考」下的 5 个旧脚本已被原作者整合进上面 2 个脚本，不重复引用，避免同一响应被多个脚本改写。

[Rule]
# —— 第一层：HTTPDNS 拦截 ——
DOMAIN-KEYWORD,httpdns,REJECT
DOMAIN-KEYWORD,httpsdns,REJECT
USER-AGENT,httpdns*,REJECT
USER-AGENT,httpsdns*,REJECT
USER-AGENT,Httpdns*,REJECT
USER-AGENT,Httpsdns*,REJECT
URL-REGEX,^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(?:\/v?[0-9]+)?\/(?:sign_)?(?:(?:d|ss)[46]?|resolve)\?,REJECT
URL-REGEX,^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?):\d+\/httpdns\/,REJECT
IP-CIDR,119.29.29.98/32,REJECT,no-resolve
IP-CIDR,119.29.29.99/32,REJECT,no-resolve
IP-CIDR,203.205.129.102/32,REJECT,no-resolve
IP-CIDR,203.205.234.132/32,REJECT,no-resolve
DOMAIN,httpdns.kg.qq.com,REJECT
DOMAIN,dns.weixin.qq.com,REJECT
DOMAIN,aedns.weixin.qq.com,REJECT
DOMAIN,twns.p2ptun.qq.com,REJECT
DOMAIN,tp2p.kg.qq.com,REJECT
# —— 第二层：腾讯广告平台（优量汇 GDT）——
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,e.qq.com,REJECT
DOMAIN-SUFFIX,gdtimg.com,REJECT
DOMAIN-SUFFIX,ugdtimg.com,REJECT
DOMAIN,qzs.qq.com,REJECT
DOMAIN,ads.privacy.qq.com,REJECT

[Host]
# 腾讯国内直连域名交给系统 DNS（当前 Wi-Fi / 运营商分配的 DNS）解析，避免配置里的境外 / 加密 DNS 解析慢或被 Wi-Fi 拦截导致首页转圈；不影响节点域名与其他域名（原样抄自 sgmodule）
qq.com = server:system
*.qq.com = server:system
*.gtimg.com = server:system
*.gtimg.cn = server:system
*.qpic.cn = server:system
*.qlogo.cn = server:system
tencent.com = server:system
*.tencent.com = server:system
*.tencent-cloud.net = server:system
*.cdn-go.cn = server:system

[Rewrite]
^https?:\/\/[^\/]+\.l\.qq\.com\/ - reject-dict
^https:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig.* - reject-200
^https:\/\/config\.ab\.qq\.com\/tab\/GetTabToggle.* - reject-200

[Script]
http-response ^https:\/\/(?:app\.sports\.qq\.com\/(?:feeds\/list|m\/matchAfter\/stats|match\/adBanner)\?|shequ\.sports\.qq\.com\/topic\/detail\?|film\.video\.qq\.com\/x\/sports-vip-channel\/(?:\?.*)?$) script-path=https://raw.githubusercontent.com/Hey-sayiwanna/TencentSports-Surge/main/TencentSportsAdBlock.js, requires-body=true, tag=腾讯体育去广告
http-response ^https:\/\/(?:app\.sports\.qq\.com\/(?:trpc\.sports_resource\.cgi\.ResourceCGI\/MatchWidgets|vaccess\/trpc\.sports_resource\.cgi\.ResourceCGI\/ColumnWidget|vaccess\/trpc\.sportsbasic\.column\.Column\/GetColumn)|sports\.qq\.com\/sapp\/h5msg\.htm|matchweb\.sports\.qq\.com\/trpc\.dorae\.coin\.Coin\/CoinLayer)(?:\?.*)?$ script-path=https://raw.githubusercontent.com/Hey-sayiwanna/TencentSports-Surge/main/TencentSportsFloatBlock.js, requires-body=true, tag=腾讯体育浮层清理
http-response ^https:\/\/k\.ssp\.qq\.com\/getsdkconfig(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/LeBron93/lewis@2f3746fc80936a35ebc2ee8283cab52ea9320966/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/init\/config(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/LeBron93/lewis@2f3746fc80936a35ebc2ee8283cab52ea9320966/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/user\/homePageV2(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/LeBron93/lewis@2f3746fc80936a35ebc2ee8283cab52ea9320966/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/m\/match\/liveSum(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/LeBron93/lewis@2f3746fc80936a35ebc2ee8283cab52ea9320966/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/match\/multiUpdate(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/LeBron93/lewis@2f3746fc80936a35ebc2ee8283cab52ea9320966/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/feeds\/(?:home|list)(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/LeBron93/lewis@2f3746fc80936a35ebc2ee8283cab52ea9320966/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/sports\.ssp\.qq\.com\/app(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/LeBron93/lewis@2f3746fc80936a35ebc2ee8283cab52ea9320966/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化

[MITM]
hostname = app.sports.qq.com, config.ab.qq.com, shequ.sports.qq.com, film.video.qq.com, sports.qq.com, matchweb.sports.qq.com, *.l.qq.com, k.ssp.qq.com, sports.ssp.qq.com
