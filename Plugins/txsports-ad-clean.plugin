#!name = 腾讯体育净化（ZenmoFeiShi）
#!desc = 去除开屏广告、优化我的页面、去除底部会员tab、优化首页展示、去除搜索热词。Loon 适配版：8 条脚本规则 1:1 对应原 QX snippet，脚本为本地 Loon 垫片副本，未在真机验证。
#!author = TG@ZenMoFiShi
#!homepage = https://github.com/ZenmoFeiShi/Qx
# Loon 适配说明（2026-11-01，用户确认信任原作者来源后制作）：
# 原 QX snippet：ZenmoFeiShi/Qx txsports-ad-clean.snippet（注明更新于 2026-11-01），8 条 script-response-body 规则 + 4 个 hostname，全部指向同一脚本 txsports-ad-clean.js。
# 本插件只做这一层，不叠加旧 TencentSports.plugin 的 HTTPDNS/GDT/Rewrite 层；两个插件同时启用会冲突（旧插件的 reject-200 会直接拦掉本插件要改写的 GetTabRemoteConfig 请求），测试时必须先停用旧插件。
# 脚本改动仅限平台 I/O 垫片（见 Scripts/txsports-ad-clean-loon.js 文件头）：$response.statusCode->$response.status、$response.bodyBytes->$response.body、$done bodyBytes->$done body；其余逻辑原样，副本与源文件不是逐字节相同。
# 仅 GetTabRemoteConfig（protobuf 二进制）一条开 binary-body-mode=true；其余 7 条保持 binary-body-mode=false，取字符串 body。QX 的 url-and-header 在 Loon 里对应 requires-body=true，脚本内自行读 $request.headers 判 UA。
# 旧插件 TencentSports.plugin 未动，可回滚。

[Script]
http-response ^https:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$ script-path=https://raw.githubusercontent.com/LeBron93/lewis/main/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=true, tag=腾讯体育净化
http-response ^https:\/\/k\.ssp\.qq\.com\/getsdkconfig(?:\?.*)?$ script-path=https://raw.githubusercontent.com/LeBron93/lewis/main/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/init\/config(?:\?.*)?$ script-path=https://raw.githubusercontent.com/LeBron93/lewis/main/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/user\/homePageV2(?:\?.*)?$ script-path=https://raw.githubusercontent.com/LeBron93/lewis/main/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/m\/match\/liveSum(?:\?.*)?$ script-path=https://raw.githubusercontent.com/LeBron93/lewis/main/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/match\/multiUpdate(?:\?.*)?$ script-path=https://raw.githubusercontent.com/LeBron93/lewis/main/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/feeds\/(?:home|list)(?:\?.*)?$ script-path=https://raw.githubusercontent.com/LeBron93/lewis/main/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/sports\.ssp\.qq\.com\/app(?:\?.*)?$ script-path=https://raw.githubusercontent.com/LeBron93/lewis/main/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化

[MITM]
hostname = config.ab.qq.com, k.ssp.qq.com, app.sports.qq.com, sports.ssp.qq.com
