#!name = 腾讯体育净化（ZenmoFeiShi）
#!desc = 去除开屏广告、优化我的页面、去除底部会员tab、优化首页展示、去除搜索热词。Loon 插件版 v6：QX 原版重写，8 条脚本规则 + HTTPDNS/GDT [Rule] 层。
#!author = TG@ZenMoFiShi
#!homepage = https://github.com/ZenmoFeiShi/Qx
# v6（2026-11-03，用户要求把 QX 版改写成 Loon 版并推仓库）：
#  上游重核：ZenmoFeiShi/Qx txsports-ad-clean.snippet，blob SHA 8a4c996332363d05727cb4b44d47496c69ab7ce0，#!update 2026-11-1；
#   txsports-ad-clean.js SHA-256 4e226de5408e8a6fb25bc5ebfd1cb802bc89097d21dc3c1e85c12f3f3d56fab4（11,795 字节），与 2026-11-01 改写时逐字节一致，上游无新改动。
#  改写方式：QX snippet 的 8 条 url script-response-body 规则逐条转 Loon http-response（url-and-header 一条转 requires-body=true，脚本内读 $request.headers 判 UA）；hostname 4 个域名原样进 [MITM]。
#  脚本：Scripts/txsports-ad-clean-loon.js，本地 Loon 垫片副本，仅 3 处平台 I/O 改动（$response.statusCode->$response.status || $response.statusCode；$response.bodyBytes->$response.bodyBytes || $response.body；$done bodyBytes->$done body），其余逻辑原样，副本与源文件不是逐字节相同（diff 已核）；node --check 通过。
#  平台 API 清单：$request.url / $request.headers / $request.body、$response.status / $response.body / $response.bodyBytes、$done；无 $prefs/$notify/$task 依赖。
#  仅 GetTabRemoteConfig（protobuf 二进制）一条开 binary-body-mode=true；其余 7 条 binary-body-mode=false，取字符串 body。
#  [Rule] 层（HTTPDNS 拦截 + GDT 广告平台拦截）沿用 v5，原样抄自旧插件 v4 的 [Rule] 段，未在真机验证；v4（无 [Rule] 层）2026-11-01 实测没效果。
#  旧插件 TencentSports.plugin 未动；两个插件同时启用会冲突（旧插件的 reject-200 会拦掉 GetTabRemoteConfig），测试时必须先停用旧插件。未在真机验证。

[Rule]
# —— 第一层：HTTPDNS 拦截 ——
DOMAIN-KEYWORD,httpdns,REJECT
DOMAIN-KEYWORD,httpsdns,REJECT
USER-AGENT,httpdns*,REJECT
USER-AGENT,httpsdns*,REJECT
USER-AGENT,Httpdns*,REJECT
USER-AGENT,Httpsdns*,REJECT
URL-REGEX,^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(?:\/v?[0-9]+)?\/(?:sign_)?(?:(?:d|ss)[46]?|resolve)\?,REJECT
URL-REGEX,^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?):\d+\/httpdns\/,REJECT
IP-CIDR,119.29.29.98/32,REJECT,no-resolve
IP-CIDR,119.29.29.99/32,REJECT,no-resolve
IP-CIDR,203.205.129.102/32,REJECT,no-resolve
IP-CIDR,203.205.234.132/32,REJECT,no-resolve
DOMAIN,httpdns.kg.qq.com,REJECT
DOMAIN,dns.weixin.qq.com,REJECT
DOMAIN,aedns.weixin.qq.com,REJECT
DOMAIN,twns.p2ptun.qq.com,REJECT
DOMAIN,tp2p.kg.qq.com,REJECT
# —— 第二层：腾讯广告平台（优量汇 GDT）——
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,e.qq.com,REJECT
DOMAIN-SUFFIX,gdtimg.com,REJECT
DOMAIN-SUFFIX,ugdtimg.com,REJECT
DOMAIN,qzs.qq.com,REJECT
DOMAIN,ads.privacy.qq.com,REJECT

[Script]
http-response ^https:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/LeBron93/lewis@2f3746fc80936a35ebc2ee8283cab52ea9320966/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=true, tag=腾讯体育净化
http-response ^https:\/\/k\.ssp\.qq\.com\/getsdkconfig(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/LeBron93/lewis@2f3746fc80936a35ebc2ee8283cab52ea9320966/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/init\/config(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/LeBron93/lewis@2f3746fc80936a35ebc2ee8283cab52ea9320966/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/user\/homePageV2(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/LeBron93/lewis@2f3746fc80936a35ebc2ee8283cab52ea9320966/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/m\/match\/liveSum(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/LeBron93/lewis@2f3746fc80936a35ebc2ee8283cab52ea9320966/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/match\/multiUpdate(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/LeBron93/lewis@2f3746fc80936a35ebc2ee8283cab52ea9320966/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/feeds\/(?:home|list)(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/LeBron93/lewis@2f3746fc80936a35ebc2ee8283cab52ea9320966/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/sports\.ssp\.qq\.com\/app(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/LeBron93/lewis@2f3746fc80936a35ebc2ee8283cab52ea9320966/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化

[MITM]
hostname = config.ab.qq.com, k.ssp.qq.com, app.sports.qq.com, sports.ssp.qq.com
