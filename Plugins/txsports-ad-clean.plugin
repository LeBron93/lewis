#!name = 腾讯体育净化（ZenmoFeiShi）
#!desc = 去除开屏广告、优化我的页面、去除底部会员tab、优化首页展示、去除搜索热词、去除新闻详情页底部推广。Loon 插件版 v14 精简：仅 QUIC 拦截＋9 条脚本规则＋MITM。
#!author = TG@ZenMoFiShi
#!homepage = https://github.com/ZenmoFeiShi/Qx
# v15（2026-11-04）：砍到 5 条规则——删 getsdkconfig、init/config、liveSum、multiUpdate 4 条未单独验证的规则，MITM 去掉仅供 getsdkconfig 的 k.ssp.qq.com；脚本未动（多余分支不再触发，留作恢复用，v14 插件已备份）。
# 上游：ZenmoFeiShi/Qx txsports-ad-clean.snippet，blob SHA 8a4c996332363d05727cb4b44d47496c69ab7ce0；脚本为本地垫片副本，仅 3 处平台 I/O 改动，非逐字节相同。仅 GetTabRemoteConfig 开 binary-body-mode=true。
# 勿与旧插件 TencentSports.plugin 同时启用（冲突）。

[Rule]
PROTOCOL,QUIC,REJECT

[Script]
http-response ^https:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/LeBron93/lewis@82288b8c4ace424dc5c623e087b90214a3cf247c/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=true, tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/user\/homePageV2(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/LeBron93/lewis@82288b8c4ace424dc5c623e087b90214a3cf247c/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/app\.sports\.qq\.com\/feeds\/(?:home|list)(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/LeBron93/lewis@82288b8c4ace424dc5c623e087b90214a3cf247c/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/sports\.ssp\.qq\.com\/app(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/LeBron93/lewis@82288b8c4ace424dc5c623e087b90214a3cf247c/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化
http-response ^https:\/\/shequ\.sports\.qq\.com\/topic\/detail(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/LeBron93/lewis@82288b8c4ace424dc5c623e087b90214a3cf247c/Scripts/txsports-ad-clean-loon.js, requires-body=true, binary-body-mode=false, tag=腾讯体育净化

[MITM]
hostname = config.ab.qq.com, app.sports.qq.com, sports.ssp.qq.com, shequ.sports.qq.com
