#!name = 美团App 12.67.403
#!icon = https://raw.githubusercontent.com/LeBron93/lewis/main/Icons/meituan-icon.png
#!desc = 美团 App 净化：去开屏、首页推荐流、我的页交叉推荐、搜索热词与小喇叭配置等，屏蔽 httpdns 与广告域名。
#!author = TG@ZenMoFiShi
#!homepage = https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/MT.snippet
# Loon 转换版：规则与脚本均来自 MT.snippet，脚本 MT.js 仅用 $request/$response/$done，Loon 无需改写
# 精简版 2026-11-07：删 33 条单 IP 拦截（域名规则已覆盖，IP 会变、基本失效）与 1 条重复的 httpdns Rewrite；MITM 去掉 2 个已被 Rule 拦截的 httpdns 主机。8 条脚本规则与可见功能不变，改动前备份在 Plugin-backups/MT-20261107-before-slim.plugin

[Rule]
DOMAIN,shark-mt.meituan.com,REJECT
DOMAIN,shark-default.meituan.com,REJECT
DOMAIN,shark-dp.meituan.com,REJECT
DOMAIN,shark-ps.meituan.com,REJECT
DOMAIN,shark-wm.sankuai.com,REJECT
DOMAIN,shark.dianping.com,REJECT
DOMAIN-WILDCARD,mquic-*.meituan.com,REJECT
DOMAIN,httpdnsmultiapi.meituan.com,REJECT
DOMAIN,httpdnsmultiapivip.meituan.com,REJECT
DOMAIN,httpdns.meituan.com,REJECT
DOMAIN,httpdnsvip.meituan.com,REJECT
DOMAIN,dnspod.meituan.httpdns.qcloud.com,REJECT
DOMAIN,dnspod.meituan.httpdns.start.qcloud.com,REJECT

[Rewrite]
^http:\/\/103\.37\.155\.60\/fetch - reject

[Script]
http-response ^https?:\/\/apimobile\.meituan\.com\/aggroup\/indexTab script-path=https://raw.githubusercontent.com/LeBron93/lewis/main/Scripts/MT.js, requires-body=true, tag=美团净化
http-response ^https?:\/\/feedguess\.meituan\.com\/lycoris\/scene\/(gwc_feed1_2265|personalcenter_2154)(\?|$) script-path=https://raw.githubusercontent.com/LeBron93/lewis/main/Scripts/MT.js, requires-body=true, tag=美团净化
http-response ^https?:\/\/mt-personalcenter\.meituan\.com\/usercenter\/display script-path=https://raw.githubusercontent.com/LeBron93/lewis/main/Scripts/MT.js, requires-body=true, tag=美团净化
http-response ^https?:\/\/apimobile\.meituan\.com\/group\/v1\/deal\/searchpage\/defaultword script-path=https://raw.githubusercontent.com/LeBron93/lewis/main/Scripts/MT.js, requires-body=true, tag=美团净化
http-response ^https?:\/\/apimobile\.meituan\.com\/group\/v1\/deal\/searchpage\/hotword\/city\/divide\/hotrecommend\/ script-path=https://raw.githubusercontent.com/LeBron93/lewis/main/Scripts/MT.js, requires-body=true, tag=美团净化
http-response ^https?:\/\/assistify\.meituan\.com\/assistant\/getAppClientHornConfig script-path=https://raw.githubusercontent.com/LeBron93/lewis/main/Scripts/MT.js, requires-body=true, tag=美团净化
http-response ^https?:\/\/mop\.meituan\.com\/mop\/entry\/shoppingCartEntry script-path=https://raw.githubusercontent.com/LeBron93/lewis/main/Scripts/MT.js, requires-body=true, tag=美团净化
http-response ^https?:\/\/mop\.meituan\.com\/api\/entryModule\/startupPicture script-path=https://raw.githubusercontent.com/LeBron93/lewis/main/Scripts/MT.js, requires-body=true, tag=美团净化

[MITM]
hostname = apimobile.meituan.com, feedguess.meituan.com, mop.meituan.com, mt-personalcenter.meituan.com, assistify.meituan.com
