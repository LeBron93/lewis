#!name=🧋 奶茶签到
#!desc=每天 8:30 自动签到：蜜雪冰城、奈雪的茶、霸王茶姬（实验性）。首次使用：打开对应小程序点一次"签到"，token 自动保存，无需手动抓包。
#!author=@LeBron93
#!homepage=https://github.com/LeBron93/lewis
#!tag=签到,奶茶,蜜雪冰城,奈雪的茶,霸王茶姬

# ============ token 自动抓取（打开小程序点一次签到即保存） ============

[rewrite_local]
^https:\/\/mxsa\.mxbc\.net\/api\/v1\/customer url script-request-header https://raw.githubusercontent.com/LeBron93/lewis/main/Scripts/MilkTeaCapture.js, tag=奶茶token抓取, enabled=true
^https:\/\/tm-web\.pin-dao\.cn\/user\/ url script-request-header https://raw.githubusercontent.com/LeBron93/lewis/main/Scripts/MilkTeaCapture.js, tag=奶茶token抓取, enabled=true
^https:\/\/webapi2\.qmai\.cn\/web\/seller\/oauth\/flash-sale-login url script-response-body https://raw.githubusercontent.com/LeBron93/lewis/main/Scripts/MilkTeaCapture.js, tag=奶茶token抓取, enabled=true

[mitm]
hostname = mxsa.mxbc.net, tm-web.pin-dao.cn, webapi2.qmai.cn

# ============ 每日 8:30 自动签到 ============

[Script]
cron "0 30 8 * * *" script-path=https://raw.githubusercontent.com/LeBron93/lewis/main/Scripts/MilkTea.js, tag=奶茶签到, timeout=90, enable=true
